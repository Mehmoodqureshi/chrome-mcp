{
  "manifest_version": 3,
  "name": "MCP Browser Extension",
  "version": "0.9.21",
  "description": "Lets your AI agent (Claude, Cursor, Codex) use the Chrome you are signed into, through a local MCP server. Deny-all by default.",
  "homepage_url": "https://mcp-browser-extension.vercel.app",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "alarms",
    "cookies",
    "debugger",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "MCP Browser Extension",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "popup.html"
  },
  "optional_permissions": [
    "nativeMessaging"
  ]
}
